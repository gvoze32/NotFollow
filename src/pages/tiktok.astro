---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import UploadCard from "../components/upload/UploadCard.astro";
import FileInput from "../components/upload/FileInput.astro";
import HowToModal from "../components/HowToModal.astro";
import NonFollowersResults from "../components/results/NonFollowersResults.astro";
---

<Layout title="TikTok NotFollow - Check Who Doesn't Follow You Back">
  <Navbar />

  <PageHero
    title="TikTok NotFollow"
    subtitle="Upload your TikTok data file to discover who doesn't follow you back"
  />

  <UploadCard howToLabel="How to Get File">
    <FileInput
      id="tiktokDataFile"
      label="TikTok Data File"
      accept=".json"
      hint="Select your user_data.json file"
    />
  </UploadCard>

  <NonFollowersResults platformName="TikTok" />

  <Footer />

  <HowToModal
    title="How to Get TikTok Data File"
    videoId="I1Nk4ag9naY"
    videoTitle="How to download TikTok data (NotFollow tutorial)"
  >
    <div
      class="rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white/40 dark:bg-black/10 p-3"
    >
      <p class="text-xs text-gray-700 dark:text-gray-300">
        Note: in <strong>Select data to download</strong>, make sure to check
        <strong>Profile and Settings</strong>, and ensure the download format is
        <strong>JSON</strong>.
      </p>
    </div>
  </HowToModal>

  <script>
    import { createResultsView, setError } from "../scripts/results";
    import { at, bindFileInput, onCheck, parseJson } from "../scripts/upload";

    const results = createResultsView({
      hiddenKey: "notfollow_hidden_tiktok_v1",
    });

    // TikTok has shipped several export layouts; read usernames from the first
    // list found, or return undefined when none of the paths exist.
    function findUsernames(data: unknown, paths: string[][]): string[] | undefined {
      for (const path of paths) {
        const rows = at(data, ...path);
        if (!Array.isArray(rows)) continue;
        return rows
          .map((row) => at(row, "UserName"))
          .filter((u): u is string => typeof u === "string" && u.length > 0);
      }
    }

    const getUserData = bindFileInput("tiktokDataFile", "TikTok data file", ([text]) => {
      const data = parseJson(text);
      const followers = findUsernames(data, [
        ["Profile", "Follower List", "FansList"],
        ["Profile", "Follower", "FansList"],
        ["Profile And Settings", "Follower", "FansList"],
        ["Follower", "FansList"],
      ]);
      const following = findUsernames(data, [
        ["Profile", "Following List", "Following"],
        ["Profile", "Following", "Following"],
        ["Profile And Settings", "Following", "Following"],
        ["Following", "Following"],
      ]);
      if (!followers && !following) {
        throw new Error(
          "no follower/following lists found — export your data as JSON with Profile and Settings included"
        );
      }
      return { followers: followers ?? [], following: following ?? [] };
    });

    onCheck(() => {
      const userData = getUserData();
      if (!userData) return setError("Please upload your TikTok user_data.json file.");
      setError("");

      const followers = new Set(userData.followers.map((u) => u.toLowerCase()));
      results.setResults(
        userData.following
          .filter((username) => !followers.has(username.toLowerCase()))
          .map((username) => ({ username, href: `https://www.tiktok.com/@${username}` }))
      );
    });
  </script>
</Layout>
