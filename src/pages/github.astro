---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ResultsCard from "../components/results/ResultsCard.astro";
import PageHero from "../components/PageHero.astro";
---

<Layout title="GitHub NotFollow - Check Who Doesn't Follow You Back">
    <Navbar />

    <PageHero
        title="GitHub NotFollow"
        subtitle="Enter a GitHub username to discover who doesn't follow you back"
    />

    <!-- Input Section -->
    <section class="pb-8 px-4 bg-white dark:bg-gray-950">
        <div class="max-w-2xl mx-auto">
            <div
                id="error-message"
                class="mb-4 text-sm text-red-600 dark:text-red-400"
            >
            </div>

            <form
                id="github-form"
                class="border border-zinc-200 dark:border-zinc-800 bg-white/40 dark:bg-black/10 backdrop-blur-sm rounded-xl p-6 mb-4"
            >
                <div class="mb-4">
                    <label
                        for="username"
                        class="block mb-2 text-sm font-medium text-black dark:text-white"
                    >
                        GitHub Username
                    </label>
                    <input
                        class="block w-full text-sm text-gray-900 dark:text-gray-400 border border-zinc-300 dark:border-zinc-700 rounded-lg cursor-pointer bg-white dark:bg-gray-900 focus:outline-none px-4 py-2"
                        id="username"
                        placeholder="e.g. octocat"
                        type="text"
                        autocomplete="off"
                        autocapitalize="off"
                        spellcheck="false"
                    />
                </div>

                <button
                    type="submit"
                    class="w-full inline-flex items-center justify-center gap-2 border border-zinc-800 dark:border-zinc-200 bg-white/40 dark:bg-black/10 backdrop-blur-sm rounded-lg px-5 py-2.5 hover:border-black dark:hover:border-white hover:bg-white/60 dark:hover:bg-white/10 text-sm font-medium text-black dark:text-white transition-all disabled:opacity-50 disabled:cursor-wait"
                >
                    <svg
                        class="w-4 h-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M9 5l7 7-7 7"></path>
                    </svg>
                    Check Non-Followers
                </button>
            </form>
        </div>
    </section>

    <ResultsCard
        title="People who don't follow you back"
        subtitleDefault="Enter a username to check"
        avatars
    />

    <Footer />

    <script>
        import { createResultsView, setError } from "../scripts/results";

        interface GitHubUser {
            login: string;
            avatar_url: string;
            html_url: string;
        }

        const PER_PAGE = 100;

        const results = createResultsView({ avatars: true });
        const form = document.getElementById("github-form") as HTMLFormElement;
        const input = document.getElementById("username") as HTMLInputElement;
        const submit = form.querySelector("button[type=submit]") as HTMLButtonElement;

        function describeFailure(response: Response, username: string): string {
            if (response.status === 404) {
                return `GitHub user "${username}" was not found.`;
            }
            if (response.headers.get("x-ratelimit-remaining") === "0") {
                const reset = Number(response.headers.get("x-ratelimit-reset"));
                const retry = reset
                    ? ` Try again after ${new Date(reset * 1000).toLocaleTimeString()}.`
                    : "";
                return `GitHub API rate limit reached (60 requests/hour without login).${retry}`;
            }
            return `GitHub API request failed (HTTP ${response.status}).`;
        }

        async function fetchAllPages(
            username: string,
            relation: "followers" | "following",
        ): Promise<GitHubUser[]> {
            const users: GitHubUser[] = [];
            for (let page = 1; ; page++) {
                const response = await fetch(
                    `https://api.github.com/users/${encodeURIComponent(username)}/${relation}?per_page=${PER_PAGE}&page=${page}`,
                );
                if (!response.ok) throw new Error(describeFailure(response, username));
                const data: GitHubUser[] = await response.json();
                users.push(...data);
                if (data.length < PER_PAGE) return users;
            }
        }

        form.addEventListener("submit", async (event) => {
            event.preventDefault();
            const username = input.value.trim();
            if (!username) {
                setError("Please enter a GitHub username.");
                return;
            }

            setError("");
            results.clear("Loading…");
            // Disabling the submit button also blocks Enter, so only one check runs at a time.
            submit.disabled = true;

            try {
                const [followers, following] = await Promise.all([
                    fetchAllPages(username, "followers"),
                    fetchAllPages(username, "following"),
                ]);
                const followerLogins = new Set(followers.map((user) => user.login));
                results.setResults(
                    following
                        .filter((user) => !followerLogins.has(user.login))
                        .map((user) => ({
                            username: user.login,
                            href: user.html_url,
                            avatarUrl: user.avatar_url,
                        })),
                );
            } catch (error) {
                setError((error as Error).message);
                results.clear("Enter a username to check");
            } finally {
                submit.disabled = false;
            }
        });
    </script>
</Layout>
