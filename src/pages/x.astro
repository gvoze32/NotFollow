---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import UploadCard from "../components/upload/UploadCard.astro";
import FileInput from "../components/upload/FileInput.astro";
import HowToModal from "../components/HowToModal.astro";
import NonFollowersResults from "../components/results/NonFollowersResults.astro";
---

<Layout title="X NotFollow - Check Who Doesn't Follow You Back">
  <Navbar />

  <PageHero
    title="X NotFollow"
    subtitle="Upload your X data file to discover who doesn't follow you back"
  />

  <UploadCard>
    <FileInput
      id="followersFile"
      label="Followers File"
      accept=".js"
      hint="Select your follower.js file"
    />
    <FileInput
      id="followingFile"
      label="Following File"
      accept=".js"
      hint="Select your following.js file"
    />
  </UploadCard>

  <NonFollowersResults platformName="X" />

  <Footer />

  <HowToModal
    title="How to Get X (Twitter) Data Files"
    videoId="Pxndi7s5oY0"
    videoTitle="How to download X (Twitter) data (NotFollow tutorial)"
  />

  <script>
    import { createResultsView, setError } from "../scripts/results";
    import { at, bindFileInput, onCheck, parseJson } from "../scripts/upload";

    const results = createResultsView({
      hiddenKey: "notfollow_hidden_x_v1",
    });

    // Archive files look like `window.YTD.follower.part0 = [{ "follower": { "accountId": … } }]`.
    function parseArchiveFile(text: string, key: "follower" | "following"): string[] {
      const wrongFile = new Error(`expected ${key}.js from your X archive`);
      const start = text.indexOf("[");
      const end = text.lastIndexOf("]");
      if (start === -1 || end < start) throw wrongFile;

      const entries = parseJson(text.slice(start, end + 1));
      if (!Array.isArray(entries)) throw wrongFile;
      return entries.map((entry) => {
        const accountId = at(entry, key, "accountId");
        if (typeof accountId !== "string" && typeof accountId !== "number") throw wrongFile;
        return String(accountId);
      });
    }

    const getFollowers = bindFileInput("followersFile", "followers file", ([text]) =>
      parseArchiveFile(text, "follower")
    );
    const getFollowing = bindFileInput("followingFile", "following file", ([text]) =>
      parseArchiveFile(text, "following")
    );

    onCheck(() => {
      const followers = getFollowers();
      const following = getFollowing();
      if (!followers) return setError("Please upload your follower.js file.");
      if (!following) return setError("Please upload your following.js file.");
      setError("");

      const followerIds = new Set(followers);
      results.setResults(
        following
          .filter((accountId) => !followerIds.has(accountId))
          .map((accountId) => ({
            username: accountId,
            href: `https://twitter.com/intent/user?user_id=${accountId}`,
          }))
      );
    });
  </script>
</Layout>
