---
const ETH_ADDRESS = "0x98441fC52b473d2E8B246315F96701484e6353CC";
---

<footer class="py-12 px-4 bg-white dark:bg-gray-950 border-t border-zinc-200 dark:border-zinc-800">
  <div class="max-w-2xl mx-auto">
    <div class="flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="text-sm text-gray-600 dark:text-gray-400 text-center md:text-left">
        <span>© {new Date().getFullYear()} </span>
        <a
          href="https://github.com/gvoze32"
          target="_blank"
          rel="noopener noreferrer"
          class="font-medium text-black dark:text-white hover:underline"
        >
          gvoze32
        </a>
      </div>

      <div class="flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400">
        <svg
          class="w-4 h-4 text-[#626890]"
          aria-hidden="true"
          fill="currentColor"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 320 512"
        >
          <path
            d="M311.9 260.8L160 353.6 8 260.8 160 0l151.9 260.8zM160 383.4L8 290.6 160 512l152-221.4-152 92.8z"
          ></path>
        </svg>
        <span class="hidden sm:inline">Support: </span>
        <button
          id="copy-eth-address"
          type="button"
          data-address={ETH_ADDRESS}
          class="text-xs px-2 py-1 bg-zinc-100 dark:bg-zinc-900 rounded font-mono hover:bg-zinc-200 dark:hover:bg-zinc-800 transition-colors cursor-pointer"
          title="Click to copy full address"
        >
          {`${ETH_ADDRESS.slice(0, 7)}...${ETH_ADDRESS.slice(-6)}`}
        </button>
      </div>
    </div>
  </div>

  <!-- Toast Notification -->
  <div
    id="copy-toast"
    class="fixed bottom-4 right-4 z-50 hidden border border-zinc-800 dark:border-zinc-200 bg-white dark:bg-gray-950 backdrop-blur-sm rounded-lg px-4 py-3 shadow-lg"
  >
    <div class="flex items-center gap-2 text-sm">
      <svg class="w-4 h-4 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
      </svg>
      <span class="text-black dark:text-white font-medium">Address copied!</span>
    </div>
  </div>
</footer>

<script>
  const button = document.getElementById("copy-eth-address");
  const toast = document.getElementById("copy-toast");
  let hideToastTimer: number | undefined;

  // execCommand fallback for browsers/contexts without the async Clipboard API.
  function copyWithTextarea(text: string): boolean {
    const textArea = document.createElement("textarea");
    textArea.value = text;
    textArea.style.position = "fixed";
    textArea.style.left = "-999999px";
    document.body.appendChild(textArea);
    textArea.select();
    try {
      return document.execCommand("copy");
    } finally {
      textArea.remove();
    }
  }

  button?.addEventListener("click", async () => {
    const address = button.dataset.address ?? "";
    let copied: boolean;
    try {
      // Throws synchronously when navigator.clipboard is undefined (non-HTTPS).
      await navigator.clipboard.writeText(address);
      copied = true;
    } catch {
      copied = copyWithTextarea(address);
    }
    if (!copied || !toast) return;

    toast.classList.remove("hidden");
    clearTimeout(hideToastTimer);
    hideToastTimer = window.setTimeout(() => toast.classList.add("hidden"), 2000);
  });
</script>
