---
// Markup for the results list driven by `src/scripts/results.ts`; element ids
// are fixed because that script looks them up.
type Props = {
    title: string;
    subtitleDefault: string;
    /** Avatar column; pair with `createResultsView({ avatars: true })`. */
    avatars?: boolean;
    /** Hide column; pair with `createResultsView({ hiddenKey })`. */
    hideable?: boolean;
};

const { title, subtitleDefault, avatars = false, hideable = false } =
    Astro.props;

const navButtonClass =
    "inline-flex items-center gap-1 border border-zinc-300 dark:border-zinc-700 bg-white/40 dark:bg-black/10 backdrop-blur-sm rounded-lg px-3 py-1.5 hover:border-zinc-800 dark:hover:border-zinc-200 hover:bg-white/60 dark:hover:bg-white/10 text-xs font-medium text-black dark:text-white transition-all disabled:opacity-50 disabled:cursor-not-allowed";
---

<section class="pb-8 px-4 bg-white dark:bg-gray-950">
    <div class="max-w-2xl mx-auto">
        <div
            class="border border-zinc-200 dark:border-zinc-800 bg-white/40 dark:bg-black/10 backdrop-blur-sm rounded-xl overflow-hidden"
        >
            <!-- Results summary -->
            <div class="p-4 border-b border-zinc-200 dark:border-zinc-800">
                <div class="flex items-center justify-between flex-wrap gap-3 mb-2">
                    <h2 class="text-lg font-semibold text-black dark:text-white">
                        {title}
                    </h2>

                    <div id="items-per-page-selector" class="hidden">
                        <label
                            for="items-per-page"
                            class="text-xs text-gray-600 dark:text-gray-400 mr-2"
                        >
                            Items per page:
                        </label>
                        <select
                            id="items-per-page"
                            class="text-xs border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-gray-900 text-black dark:text-white rounded-lg px-2 py-1 focus:outline-none focus:border-zinc-800 dark:focus:border-zinc-200 appearance-none cursor-pointer"
                            style="padding-right: 1.5rem; background-image: none;"
                        >
                            <option value="10" selected>10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                    </div>
                </div>

                <p
                    id="results-summary"
                    class="text-sm text-gray-600 dark:text-gray-400"
                    aria-live="polite"
                >
                    {subtitleDefault}
                </p>
            </div>

            <div
                id="results-search-controls"
                class="hidden px-4 py-3 border-b border-zinc-200 dark:border-zinc-800"
            >
                <label for="results-search" class="sr-only">Search usernames</label>
                <input
                    id="results-search"
                    type="search"
                    placeholder="Search usernames…"
                    autocomplete="off"
                    class="block w-full max-w-sm text-sm text-gray-900 dark:text-gray-200 border border-zinc-300 dark:border-zinc-700 rounded-lg bg-white dark:bg-gray-900 px-3 py-2 focus:outline-none focus:border-zinc-800 dark:focus:border-zinc-200"
                />
            </div>

            <!-- Pagination controls -->
            <div
                id="pagination-controls"
                class="hidden p-4 border-b border-zinc-200 dark:border-zinc-800"
            >
                <div class="flex items-center justify-between flex-wrap gap-3">
                    <div
                        id="pagination-info"
                        class="text-xs text-gray-600 dark:text-gray-400"
                    >
                        Showing 0 to 0 of 0
                    </div>

                    <div class="flex items-center gap-2">
                        <button
                            type="button"
                            id="prev-page"
                            class={navButtonClass}
                            disabled
                        >
                            <svg
                                class="w-3.5 h-3.5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                aria-hidden="true"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M15 19l-7-7 7-7"></path>
                            </svg>
                            Previous
                        </button>

                        <div id="page-numbers" class="flex items-center gap-1">
                        </div>

                        <button type="button" id="next-page" class={navButtonClass}>
                            Next
                            <svg
                                class="w-3.5 h-3.5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                aria-hidden="true"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M9 5l7 7-7 7"></path>
                            </svg>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Optional notes above the table -->
            <slot />

            <div class="overflow-x-auto">
                <table class="w-full text-sm table-fixed">
                    <thead
                        class="text-xs uppercase bg-zinc-50 dark:bg-zinc-900 text-gray-700 dark:text-gray-400"
                    >
                        <tr>
                            <th scope="col" class="w-16 px-4 py-2 text-center font-medium">
                                No.
                            </th>
                            {
                                avatars && (
                                    <th scope="col" class="w-16 px-4 py-2 text-center font-medium">
                                        Avatar
                                    </th>
                                )
                            }
                            <th scope="col" class="px-4 py-2 text-left font-medium">
                                Username
                            </th>
                            {
                                hideable && (
                                    <th scope="col" class="w-20 px-4 py-2 text-center font-medium">
                                        Hide
                                    </th>
                                )
                            }
                        </tr>
                    </thead>
                    <tbody
                        id="resultList"
                        class="divide-y divide-zinc-200 dark:divide-zinc-800"
                    >
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
