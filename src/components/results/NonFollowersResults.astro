---
import ResultsCard from "./ResultsCard.astro";

type Props = {
  /** Platform name used in the deactivated-accounts note (e.g. "Instagram") */
  platformName: string;
};

const { platformName } = Astro.props;
---

<ResultsCard
  title="People who don't follow you back"
  subtitleId="total-to-unfollow"
  subtitleDefault="Upload files to see results"
  itemsPerPageSelectorId="items-per-page-selector"
  paginationControlsId="pagination-controls"
  paginationInfoId="pagination-info"
  pageNumbersId="page-numbers"
  prevPageButtonId="prev-page"
  nextPageButtonId="next-page"
  prevPageOnClick="previousPage()"
  nextPageOnClick="nextPage()"
  itemsPerPageSelectId="itemsPerPage"
  itemsPerPageOnChange="changeItemsPerPage()"
>

  <div
    class="px-4 pt-3 flex items-start justify-between gap-3 flex-wrap text-xs text-gray-500 dark:text-gray-400"
  >
    <p class="max-w-md">
      Note: accounts that are deactivated can show up here — {platformName}
      removes them from your followers export while they're inactive. Use
      <strong>Hide</strong> to exclude them.
    </p>
    <button
      id="reset-hidden"
      type="button"
      onclick="resetHidden()"
      class="hidden underline hover:text-black dark:hover:text-white transition-colors"
    >
      Reset hidden (<span id="hidden-count">0</span>)
    </button>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-sm table-fixed">
      <thead
        class="text-xs uppercase bg-zinc-50 dark:bg-zinc-900 text-gray-700 dark:text-gray-400"
      >
        <tr>
          <th scope="col" class="w-16 px-4 py-2 text-center font-medium">
            No.
          </th>
          <th scope="col" class="px-4 py-2 text-left font-medium">
            Username
          </th>
          <th scope="col" class="w-20 px-4 py-2 text-center font-medium">
            Hide
          </th>
        </tr>
      </thead>
      <tbody
        id="resultList"
        class="divide-y divide-zinc-200 dark:divide-zinc-800"
      >
        <!-- Results will be inserted here -->
      </tbody>
    </table>
  </div>
</ResultsCard>
